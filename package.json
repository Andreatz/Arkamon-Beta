{
  "name": "arkamon",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Arkamon - gioco ibrido tra Pokémon e boardgame con dadi D6",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "vfx:runtime": "node scripts/build-vfx-runtime-assets.mjs",
    "deploy": "npm run build && gh-pages -d dist",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "vfx:sheets": "node scripts/build-vfx-spritesheets.mjs --input ./vfx-source/raw --output ./public/vfx/generated --fps 24 --maxColumns 8 --maxCellWidth 640 --maxCellHeight 640 --overwrite",
    "vfx:build": "npm run vfx:sheets && npm run vfx:runtime"
  },
  "dependencies": {
    "framer-motion": "11.18.2",
    "qrcode": "1.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zustand": "4.5.7"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.2",
    "@types/node": "25.9.1",
    "@types/qrcode": "1.5.5",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "5.2.0",
    "autoprefixer": "10.4.20",
    "gh-pages": "6.3.0",
    "postcss": "8.5.15",
    "sharp": "0.34.5",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.3",
    "vite": "7.3.5",
    "vitest": "4.1.8"
  },
  "overrides": {
    "vite": "7.3.5",
    "@vitejs/plugin-react": "5.2.0",
    "tailwindcss": "3.4.17"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
